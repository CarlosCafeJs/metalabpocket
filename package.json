{
  "name": "metalab-pocket",
  "private": true,
  "version": "1.0.0",
  "description": "Simulador educacional MetaLab Pocket",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:run": "electron .",
    "desktop:test": "node --test scripts/desktop-flow-check.mjs",
    "desktop:dir": "electron-builder --dir --config electron-builder.config.cjs",
    "desktop:dist:win": "electron-builder --win nsis --config electron-builder.config.cjs",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "instalab:bill": "node scripts/bill-instalab-campaigns.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "main": "electron/main.cjs"
}
