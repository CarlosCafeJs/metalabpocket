DATABASE_URL=postgresql://usuario:senha@host:porta/banco
# HMAC key used to store searchable CPF digests; generate a random secret of at least 32 bytes.
EDUCAFE_STUDENT_CPF_PEPPER=
# HMAC key exclusivo para localizar CPFs docentes (mínimo 32 bytes aleatórios).
EDUCAFE_TEACHER_CPF_PEPPER=
# Duração opcional da sessão do aluno (1 a 24 horas; padrão 12).
EDUCAFE_SESSION_HOURS=12
# Provisionamento manual do primeiro administrador; use somente no terminal autorizado e remova após o comando.
# EDUCAFE_TEACHER_ADMIN_NAME=
# EDUCAFE_TEACHER_ADMIN_CPF=
# EDUCAFE_TEACHER_ADMIN_EMAIL=
# EDUCAFE_TEACHER_ADMIN_PASSWORD=
# TLS é obrigatório em todos os ambientes.
DATABASE_SSL=true
DATABASE_CA=
DATABASE_SSL_SERVERNAME=localhost

# A autenticação docente usa apenas contas aprovadas no banco (migration 019).
# Não adicione credenciais docentes antigas por variáveis de ambiente.
