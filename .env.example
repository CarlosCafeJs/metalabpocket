DATABASE_URL=postgresql://usuario:senha@host:porta/banco
# Apenas no PostgreSQL local do compose.yaml. Em produção, mantenha o TLS habilitado.
DATABASE_SSL=true
DATABASE_CA=
DATABASE_SSL_SERVERNAME=localhost
# Apenas local: permite TLS sem validar o certificado autoassinado do proxy Railway.
# Não configure em produção/Vercel. O código ignora esta opção nesses ambientes.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Área do professor: configure CPF somente com permissão para acessar os dados da turma.
METALAB_TEACHER_CPF=00000000000
METALAB_TEACHER_PASSWORD=troque-por-uma-senha-forte
METALAB_TEACHER_SESSION_SECRET=gere-um-segredo-aleatorio-com-ao-menos-32-caracteres
